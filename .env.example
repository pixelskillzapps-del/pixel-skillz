# Isko copy karke ".env" naam se save karein
NODE_ENV=production
PORT=3000

# Ye zaroor badlein — lamba random string. Banane ke liye:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=yahan-lamba-random-string-daalein

# Pehli baar server chalane par admin bana lega.
# Agar aap khud password rakhna chahte hain to yahan likhein,
# warna server khud ek random password banakar data/FIRST-LOGIN.txt me likh dega.
ADMIN_USER=admin
ADMIN_PASSWORD=01125001002
