<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="top">
<section style="padding:44px 0 10px">
  <div class="wrap">
    <div class="sh">
      <span class="kicker rv">Courses</span>
      <h2 class="rv">Hamare Courses</h2>
      <p class="sub rv">Class 1 se 12 tak har subject</p>
    </div>
  </div>
</section>

<!-- ================= POPULAR COURSES ================= -->
<section class="white" id="courses">
  <div class="wrap">
    <div class="sh">
      <h2 class="rv">Hamare <em>Popular</em> Courses</h2>
      <p class="sub rv">Har stage ke student ke liye banaye gaye program</p>
    </div>
    <div class="carousel rv">
      <div class="track" id="courseTrack">
        <% courses.forEach(function(c){ %>
        <div class="course">
          <div class="cthumb <%= c.theme %>">
            <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.4"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
            <div class="cbadges"><% if(c.badge1){ %><span class="cbadge"><%= c.badge1 %></span><% } %><% if(c.badge2){ %><span class="cbadge o"><%= c.badge2 %></span><% } %></div>
          </div>
          <div class="cbody"><h3><%= c.title %></h3>
            <div class="cfoot"><span><%= c.meta1 %></span><span><%= c.meta2 %></span></div></div>
        </div>
        <% }); %>
      </div>
      <div class="arrows"><button id="cPrev" aria-label="Pichla">‹</button><button id="cNext" aria-label="Agla">›</button></div>
    </div>
  </div>
</section>

<!-- ================= WHAT WE PROVIDE ================= -->
<section id="provide">
  <div class="wrap">
    <div class="sh">
      <h2 class="rv">Hum Kya <em>Dete</em> Hain</h2>
      <p class="sub rv">Har student ki zaroorat ke liye alag program</p>
    </div>
    <div class="tiles">
      <a class="tile rv" href="/courses"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M8 10h8M8 13h5"/></svg></div><b>Regular Batch</b></a>
      <a class="tile rv" href="/courses"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M13 7l-4 6h3l-1 5 4-6h-3z"/></svg></div><b>Crash Course</b></a>
      <a class="tile rv" href="/courses"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M9 12l2 2 4-4"/></svg></div><b>Board Revision</b></a>
      <a class="tile rv" href="/courses"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M12 16v.5M12 8a2 2 0 0 1 1 3.7c-.6.4-1 .8-1 1.6"/></svg></div><b>Doubt Batch</b></a>
      <a class="tile rv" href="/computer"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><rect x="7.5" y="8.5" width="9" height="6" rx="1"/><path d="M10 17h4"/></svg></div><b>Computer Lab</b></a>
      <a class="tile rv" href="/3d-lab"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M12 7l5 2.8v5.4L12 18l-5-2.8V9.8z"/></svg></div><b>3D Learning</b></a>
      <a class="tile rv" href="/contact"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M12 9.5a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6z"/><path d="M8.5 17c.5-1.8 1.9-2.7 3.5-2.7s3 .9 3.5 2.7"/></svg></div><b>Home Tuition</b></a>
      <a class="tile rv" href="/contact"><div class="hx"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.3"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z"/><path d="M9 10h6M9 13h6M11 16h2"/></svg></div><b>Counselling</b></a>
    </div>
  </div>
</section>

<!-- ================= FEES ================= -->
<section class="white" id="fees">
  <div class="wrap">
    <div class="sh">
      <h2 class="rv">Fees — <em>Saaf Saaf</em></h2>
      <p class="sub rv">Koi chhupi baat nahi. Bhai-behen dono padhein to 10% chhoot.</p>
    </div>
    <div class="table-wrap rv">
      <table>
        <thead><tr><th>Batch</th><th>Timing</th><th>Din</th><th>Fees / mahina</th></tr></thead>
        <tbody>
          <% fees.forEach(function(f){ %>
          <tr><td><%= f.batch %></td><td><%= f.timing %></td><td><%= f.days %></td><td class="fee"><%= f.amount %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="form-note rv" style="text-align:center">Ye sample rates hain — file me <b>fees</b> table dhoondh kar apne asli rate bhar lein.</p>
  </div>
</section>

<!-- ================= CTA BAND ================= -->
<section style="padding-top:20px">
  <div class="wrap">
    <div class="cta rv">
      <div class="cta-side l"><%- include('../partials/photo',{slot:'ctaL',cls:'p-a',label:''}) %></div>
      <div class="cta-side r"><%- include('../partials/photo',{slot:'ctaR',cls:'p-c',label:''}) %></div>
      <h2>Pixel Skillz me har bachche ko alag se guide kiya jaata hai — doubt solving, stream selection aur planning ke saath.</h2>
      <p>Ek demo class free hai. Bachche ko ek din baithaakar dekhiye, phir faisla kijiye.</p>
      <a class="btn btn-white" href="#" data-modal>Get Started Now <span class="sq">›</span></a>
    </div>
  </div>
</section>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/modal') %>
<%- include('../partials/floats') %>
<script src="/js/site.js"></script>
</body>
</html>
