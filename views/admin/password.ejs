<%- include('_layout', {title:'Password', nav:'password'}) %>
<div class="head"><h1>Password badlein</h1></div>
<% if (error) { %><div class="msg bad"><%= error %></div><% } %>
<% if (done) { %><div class="msg ok">Password badal diya gaya.</div><% } %>
<div class="card" style="max-width:460px">
  <form method="post" action="/admin/password" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div style="margin-bottom:14px"><label>Purana password</label><input name="current" type="password" required></div>
    <div style="margin-bottom:14px"><label>Naya password</label><input name="next" type="password" required minlength="10"></div>
    <div style="margin-bottom:14px"><label>Naya password dobara</label><input name="confirm" type="password" required minlength="10"></div>
    <button class="btn btn-navy" type="submit">Badlein</button>
  </form>
  <p class="tiny" style="margin-top:14px">Kam se kam 10 akshar. Apna naam, coaching ka naam ya 12345 jaisa password mat rakhein — do lambe shabd jod lena sabse aasan aur mazboot tareeka hai.</p>
</div>
<%- include('_end') %>
